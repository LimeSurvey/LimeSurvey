{#
/**
 * Multiple Choice Html : item 'other' row
 *
 * @var $sDisable
 * @var $myfname
 * @var $othertext
 * @var $othertextRight
 * @var $otherItemExtraClass
 * @var $checkedState
 * @var $sValue
 * @var $oth_checkconditionFunction
 * @var $checkconditionFunction
 * @var $sValueHidden
 * @var $wrapper
 * @var $otherInputSize
 * @var $otherMaxLength
 */
#}

<!-- answer_row_other -->
<li id='javatbd{{ myfname }}' class='question-item answer-item checkbox-text-item {{ relevanceClass }} {{ otherItemExtraClass }}'>
    <div class="row">
        <div class="col-auto d-flex">
            <!-- Checkbox + label -->
            <div class="checkbox-item othertext-label-checkox-container">
                <!-- checkbox -->
                <span
                    id="answer{{ myfname }}cbox"
                    class="other-checkbox ls-no-js-hidden visual-checkbox{% if sValue %} checkbox-checked{% endif %}"
                    aria-hidden="true"
                /></span>
                <label for="answer{{ myfname }}" class="checkbox-label control-label answertext"
                   id="label-{{ myfname }}-other">{{ processString(othertext) }}</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="text-item other-text-item">
                <input
                    class="form-control input-sm mt-1"
                    type="text"
                    name="{{ myfname }}"
                    id="answer{{ myfname }}"
                    value="{{ sValue }}"
                    {% if othertext is empty and othertextRight is defined and othertextRight|length > 0 %}
                        aria-labelledby="label-{{ myfname }}-other suffix-{{ myfname }}-other"
                    {% endif %}
                    {% if otherInputSize %} size="{{ otherInputSize }}" {% endif %}
                    {% if otherMaxLength %} maxlength="{{ otherMaxLength }}" {% endif %}
                />
            </div>
        </div>

        {% if othertextRight is defined and othertextRight|length >0 %}
            <div class="othertext-suffix-label col-auto" id="suffix-{{ myfname }}-other">
                {{ processString(othertextRight) }}
            </div>
        {% endif %}

        <!-- hidden input -->
        <input
            type="hidden"
            name="java{{ myfname }}"
            id="java{{ myfname }}"
            value="{{ sValueHidden }}"
        />
    </div>
    <script type='text/javascript'>
        $(function () {
            if ($.trim($('#answer{{ myfname }}').val()).length == 0) {
                LEMflagMandOther("{{ myfname }}", true);
            }
        });
        $('#answer{{ myfname }}').on('keyup focusout', function (event) {
            if ($.trim($(this).val()).length > 0) {
                $("#answer{{ myfname }}cbox").addClass("checkbox-checked");
            } else {
                $("#answer{{ myfname }}cbox").removeClass("checkbox-checked");
            }
            $("#java{{ myfname }}").val($(this).val());
            LEMflagMandOther("{{ myfname }}", $.trim($(this).val()).length > 0);
            {{ oth_checkconditionFunction }}(this.value, this.name, this.type);
        });

        $('#answer{{ myfname }}cbox').click(function (event) {
            $("#answer{{ myfname }}").focus();
        });
    </script>
</li> <!-- Form group ; item row -->
<!-- end of answer_row_other -->
