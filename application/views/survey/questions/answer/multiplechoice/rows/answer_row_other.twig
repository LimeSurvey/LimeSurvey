{#
/**
 * Multiple Choice Html : item 'other' row
 *
 * @var $sDisable
 * @var $myfname
 * @var $othertext
 * @var $othertextRight
 * @var $otherItemExtraClass
 * @var $checkedState
 * @var $sValue
 * @var $oth_checkconditionFunction
 * @var $checkconditionFunction
 * @var $sValueHidden
 * @var $wrapper
 * @var $otherInputSize
 * @var $otherMaxLength
 * @var $otherMandatoryTipId id of the shown "please specify" tip, else empty
 * @var $otherInvalid the submit was blocked because Other is ticked without text
 */
#}

<!-- answer_row_other -->
<li id='javatbd{{ myfname }}' class='question-item answer-item checkbox-text-item {{ relevanceClass }} {{ otherItemExtraClass }}'>
    <div class="row">
        <div class="col-auto d-flex">
            <!-- Checkbox + label -->
            <div class="checkbox-item othertext-label-checkox-container">
                <!-- checkbox -->
                <input
                    class="other-checkbox"
                    type="checkbox"
                    name="{{ myfname }}cbox"
                    id="answer{{ myfname }}cbox"
                    aria-describedby="hint-{{ myfname }}-other"
                    {{ checkedState }}
                />
                <label for="answer{{ myfname }}cbox" class="checkbox-label control-label answertext"
                       id="label-{{ myfname }}-other">{{ processString(othertext) }}</label>
                <!-- ticking moves the focus to the text field, tell it in advance (WCAG 3.2.2) -->
                <span class="visually-hidden" id="hint-{{ myfname }}-other">{{ gT("Selecting this option moves the focus to its text field.") }}</span>
            </div>
        </div>
        <div class="col-auto">
            <div class="text-item other-text-item">
                <input
                    class="form-control input-sm mt-1"
                    type="text"
                    name="{{ myfname }}"
                    id="answer{{ myfname }}"
                    value="{{ sValue }}"
                    {% if othertextRight is defined and othertextRight|length > 0 %}
                        aria-labelledby="{% if othertext is not empty %}label-{{ myfname }}-other {% endif %}suffix-{{ myfname }}-other"
                    {% else %}
                        aria-labelledby="label-{{ myfname }}-other"
                    {% endif %}
                    {% if otherMandatoryTipId %} aria-describedby="{{ otherMandatoryTipId }}" {% endif %}
                    {% if otherInvalid %} aria-invalid="true" {% endif %}
                    {% if otherInputSize %} size="{{ otherInputSize }}" {% endif %}
                    {% if otherMaxLength %} maxlength="{{ otherMaxLength }}" {% endif %}
                />
            </div>
        </div>

        {% if othertextRight is defined and othertextRight|length >0 %}
            <div class="othertext-suffix-label col-auto" id="suffix-{{ myfname }}-other">
                {{ processString(othertextRight) }}
            </div>
        {% endif %}

        <!-- hidden input -->
        <input
            type="hidden"
            name="java{{ myfname }}"
            id="java{{ myfname }}"
            value="{{ sValueHidden }}"
        />
        <!-- announces that typing ticked Other -->
        {% set otherLabel = (othertext is not empty ? processString(othertext) : processString(othertextRight|default(''))) | striptags | trim %}
        <span class="visually-hidden" id="status-{{ myfname }}-other" aria-live="polite"
              data-message="{{ gT("The option '%s' has been selected.", 'unescaped')|format(otherLabel)|escape('html_attr') }}"></span>
    </div>
    <script type='text/javascript'>
        $(function () {
            if ($('#answer{{ myfname }}cbox').is(':checked') && $.trim($('#answer{{ myfname }}').val()).length == 0) {
                LEMflagMandOther("{{ myfname }}", true);
            }
        });

        $('#answer{{ myfname }}').on('keyup focusout', function (event) {
            if ($.trim($(this).val()).length > 0) {
                if (!$("#answer{{ myfname }}cbox").is(':checked')) {
                    $("#answer{{ myfname }}cbox").prop("checked", true);
                    $("#status-{{ myfname }}-other").text($("#status-{{ myfname }}-other").data('message'));
                }
                $(this).removeAttr('aria-invalid');
            }
            $("#java{{ myfname }}").val($(this).val());
            LEMflagMandOther("{{ myfname }}", $('#answer{{ myfname }}cbox').is(":checked"));
            {{ oth_checkconditionFunction }}(this.value, this.name, this.type);
        });

        $('#answer{{ myfname }}cbox').click(function (event) {
            if (($(this)).is(':checked')) {
                $("#answer{{ myfname }}").focus();
                LEMflagMandOther("{{ myfname }}", true);
            } else {
                $("#answer{{ myfname }}").val('').removeAttr('aria-invalid');
                $("#java{{ myfname }}").val('');
                {{ checkconditionFunction }}("", "{{ myfname }}", "text");
                LEMflagMandOther("{{ myfname }}", false);
            }
        });
    </script>
</li> <!-- Form group ; item row -->
<!-- end of answer_row_other -->
