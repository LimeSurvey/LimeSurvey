{#
/**
 * Multiple Choice Html : item 'other' row
 *
 * @var $sDisable
 * @var $myfname
 * @var $othertext
 * @var $othertextRight
 * @var $otherItemExtraClass
 * @var $checkedState
 * @var $sValue
 * @var $oth_checkconditionFunction
 * @var $checkconditionFunction
 * @var $sValueHidden
 * @var $wrapper
 * @var $otherInputSize
 * @var $otherMaxLength
 */
#}

<!-- answer_row_other -->
<li id='javatbd{{ myfname }}' class='question-item answer-item checkbox-text-item {{ relevanceClass }} {{ otherItemExtraClass }}'>
    <div class="row align-items-baseline">
        <label for="answer{{ myfname }}" class="col-auto checkbox-label control-label answertext"
               id="label-{{ myfname }}-other">{{ processString(othertext) }}</label>
        <div class="col text-item ">
            <input
                class="form-control input-sm mt-1"
                type="text"
                name="{{ myfname }}"
                id="answer{{ myfname }}"
                value="{{ sValue }}"
                {% if othertext is empty and othertextRight is defined and othertextRight|length > 0 %}
                    aria-labelledby="suffix-{{ myfname }}-other"
                {% else %}
                    aria-labelledby="label-{{ myfname }}-other"
                {% endif %}
                {% if otherInputSize %} size="{{ otherInputSize }}" {% endif %}
                {% if otherMaxLength %} maxlength="{{ otherMaxLength }}" {% endif %}
            />
        </div>
        {% if othertextRight is defined and othertextRight|length >0 %}
            <div class="othertext-suffix-label col-auto" id="suffix-{{ myfname }}-other">
                {{ processString(othertextRight) }}
            </div>
        {% endif %}

        <!-- hidden input -->
        <input
            type="hidden"
            name="java{{ myfname }}"
            id="java{{ myfname }}"
            value="{{ sValueHidden }}"
        />
    </div>
</li> <!-- Form group ; item row -->
<!-- end of answer_row_other -->
