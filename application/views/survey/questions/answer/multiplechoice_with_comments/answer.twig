{#
/**
 * Multiple Choice with Comment question item Html
 *
 * @var $sRows      : the rows, generated with the views rows/answer_row.php
 *
 * @var $name
 * @var $value
 * @var $maxAnswers : int|null 最多可选个数（max_answers）
 * @var $questionId : int 题目 ID（超限提示定位用）
 */
#}
<!-- Multiple Choice with comment-->

<!-- answer -->
<input type='hidden' name='{{ name }}' value='{{ value }}' />
<ul class="{{ coreClass }} list-unstyled" role="group" aria-labelledby="ls-question-text-{{ basename }}"
    {%- if maxAnswers is not null %} data-max-answers="{{ maxAnswers }}" data-question-id="{{ questionId }}"{% endif %}>
        {% for aRow in aRows %}
                {% set rowTemplate = aRow.other ? './survey/questions/answer/multiplechoice_with_comments/rows/answer_row_other.twig' : './survey/questions/answer/multiplechoice_with_comments/rows/answer_row.twig' %}
                {% include rowTemplate with aRow %}
        {% endfor %}
</ul>
<!-- end of answer -->
