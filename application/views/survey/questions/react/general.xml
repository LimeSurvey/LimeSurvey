<?xml version="1.0" encoding="UTF-8"?>
<!-- Editor UI overlay: merged by attribute name into the config.xml attributes of every question theme. -->
<react>
    <tab>General</tab>
    <attributes>
        <attribute>
            <name>title</name>
            <virtual>1</virtual>
            <always>1</always>
            <sortorder>1</sortorder>
            <component>QuestionCodeAttribute</component>
            <attributePath>title</attributePath>
            <returnValues>
                <value>title</value>
            </returnValues>
        </attribute>
        <attribute>
            <name>questionThemeName</name>
            <virtual>1</virtual>
            <always>1</always>
            <sortorder>2</sortorder>
            <component>QuestionTypeAttribute</component>
            <attributePath>questionThemeName</attributePath>
            <returnValues>
                <value>type</value>
                <value>questionThemeName</value>
            </returnValues>
        </attribute>
        <attribute>
            <name>mandatory</name>
            <sortorder>3</sortorder>
            <component>ToggleButtons</component>
            <caption>Mandatory</caption>
            <optionsPreset>mandatory</optionsPreset>
            <default>false</default>
            <props>
                <id>mandatory</id>
            </props>
        </attribute>
        <attribute>
            <name>numbers_only</name>
            <component>ToggleButtons</component>
            <caption>Numbers only</caption>
            <optionsPreset>onOff</optionsPreset>
            <default>0</default>
            <props>
                <id>numbers-only-attribute-question-settings</id>
            </props>
        </attribute>
        <attribute>
            <name>maximum_chars</name>
            <component>Input</component>
            <caption>Maximum characters</caption>
            <props>
                <id>maximum-characters</id>
                <allowEmpty>1</allowEmpty>
                <placeholder>500</placeholder>
                <type>number</type>
            </props>
        </attribute>
        <attribute>
            <name>encrypted</name>
            <sortorder>4</sortorder>
            <component>ToggleButtons</component>
            <caption>Store answers encrypted</caption>
            <optionsPreset>yesNo</optionsPreset>
            <optionsVariant>boolean</optionsVariant>
            <default>false</default>
            <props>
                <id>general-encrypted</id>
            </props>
        </attribute>
        <attribute>
            <name>save_as_default</name>
            <sortorder>5</sortorder>
            <component>DefaultValuesActions</component>
            <attributePath>defaultAttributeValuesActions</attributePath>
            <action>1</action>
        </attribute>
        <attribute>
            <!-- Handled by DefaultValuesActions together with save_as_default -->
            <name>clear_default</name>
            <hidden>1</hidden>
        </attribute>
        <attribute>
            <name>other</name>
            <sortorder>6</sortorder>
            <component>ToggleButtons</component>
            <caption>Other</caption>
            <optionsPreset>onOff</optionsPreset>
            <optionsVariant>boolean</optionsVariant>
            <default>false</default>
            <props>
                <id>general-other</id>
            </props>
        </attribute>
        <attribute>
            <name>preg</name>
            <sortorder>7</sortorder>
            <component>Input</component>
            <caption>Input validation</caption>
        </attribute>
        <attribute>
            <name>relevance</name>
            <sortorder>8</sortorder>
            <component>Input</component>
            <caption>Logic</caption>
            <devOnly>1</devOnly>
        </attribute>
        <attribute>
            <!-- Rendered by QuestionTypeAttribute -->
            <name>question_template</name>
            <hidden>1</hidden>
        </attribute>
        <attribute>
            <name>gid</name>
            <hidden>1</hidden>
        </attribute>
    </attributes>
</react>
