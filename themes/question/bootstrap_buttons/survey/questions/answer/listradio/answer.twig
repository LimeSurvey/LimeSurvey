{#
/**
 * List Radio Html
 *
 * @var $name
 * @var $value
 * @var $othertext
 * @var $otherTextRight
 * @var $otherInputSize
 * @var $otherMaxLength
 */
#}

<!-- List Radio -->
<!-- answer -->
{# Translate the col-md-* option of "Maximum number of buttons in a row" into a fixed grid column count #}
{% set buttons_per_row_map = {'col-md-12': 1, 'col-md-6': 2, 'col-md-4': 3, 'col-md-3': 4, 'col-md-2': 6, 'col-md-1': 12} %}
{% set max_buttons_row_value = question_template_attribute.max_buttons_row|default('') %}
{% set buttons_cols_class = max_buttons_row_value in buttons_per_row_map|keys ? 'bootstrap-buttons-cols-' ~ buttons_per_row_map[max_buttons_row_value] : '' %}
{{ sTimer }}
<div>
    <ul class="{{coreClass}} list-unstyled bootstrap-buttons-list {{ buttons_cols_class }}" data-bs-toggle="buttons" role="radiogroup" aria-labelledby="ls-question-text-{{name }}">
    {# rows/answer_row.php #}
    {{ sRows }}
    </ul>

    {# Value for expression manager javascript (use id) ; no need to submit #}
    {{ C.Html.hiddenField("java"~name,value,({
        'id' : "java"~name,
        'disabled' : true,
    }))
    }}
    {# Must add it only if other is set ! #}
    <div class="row align-items-center mb-3 ls-js-hidden answer-item" id="div{{ name }}other">
        <div class="col-auto">
            <label for="answer{{ name }}othertext" class="col-form-label" id="label-id-{{ name }}">{{ processString(othertext) }}</label>
        </div>
        <div class="col-auto">
            <input
                type="text"
                class="form-control input-sm"
                id="answer{{ name }}othertext"
                name="{{ name }}_Cother"
                aria-labelledby="label-id-{{ name }}"
                {% if otherInputSize %} size="{{ otherInputSize }}" {% endif %}
                {% if otherMaxLength %} maxlength="{{ otherMaxLength }}" {% endif %}
            >
        </div>
        {% if otherTextRight is defined and otherTextRight|length > 0 %}
            <div class="othertext-suffix-label button-suffix col-auto">
                {{ processString(otherTextRight) }}
            </div>
        {% endif %}
    </div>
</div>
<script>doBootstrapRadioOther();</script>

<!-- end of answer -->
