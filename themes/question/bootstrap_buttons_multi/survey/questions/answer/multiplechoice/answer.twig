{# 
/**
 * Multiple Choice question item Html
 *
 * @var $sRows      : the rows, generated with the views rows/answer_row*.php
 *
 * @var $name
 * @var $anscount
 * @var $othertext
 * @var $otherTextRight
 * @var $otherInputSize
 * @var $otherMaxLength
 * @var $otherMandatoryTipId id of the shown "please specify" tip, else empty
 * @var $otherInvalid the submit was blocked because Other is ticked without text
 */
 #}
<!-- Multiple Choice -->

<!-- answer -->

{% set button_size_class = (question_template_attribute.button_size == 'default' or question_template_attribute.button_size is empty) ? '' : "btn-"~question_template_attribute.button_size %}
{% set max_buttons_row = (question_template_attribute.max_buttons_row == 'default' or question_template_attribute.max_buttons_row is empty) ? 'col-md-2' : question_template_attribute.max_buttons_row %}
{# Translate the col-md-* option of "Maximum number of buttons in a row" into a fixed grid column count #}
{% set buttons_per_row_map = {'col-md-12': 1, 'col-md-6': 2, 'col-md-4': 3, 'col-md-3': 4, 'col-md-2': 6, 'col-md-1': 12} %}
{% set max_buttons_row_value = question_template_attribute.max_buttons_row|default('') %}
{% set buttons_cols_class = max_buttons_row_value in buttons_per_row_map|keys ? 'bootstrap-buttons-cols-' ~ buttons_per_row_map[max_buttons_row_value] : '' %}
<input type="hidden" name="MULTI{{name}}" value="{{anscount}}" />
<div class="{{coreClass}} {{ extraclass }}" >
    <ul class="list-unstyled bootstrap-buttons-list {{ buttons_cols_class }}" data-bs-toggle="buttons" role="group" aria-labelledby="ls-question-text-{{basename }}">
        {% for aRow in aRows %}
            {% set aRow = aRow|merge({'button_size_class': button_size_class})|merge({'max_buttons_row': max_buttons_row}) %}
            {% set rowTemplate = aRow.other ? './survey/questions/answer/multiplechoice/rows/answer_row_other.twig' : './survey/questions/answer/multiplechoice/rows/answer_row.twig' %}
            {% include rowTemplate with aRow %}
        {% endfor %}
    </ul>
    <!-- other -->
    {% if other in aRows|keys %}
    <div class="d-none col-12 answer-item" id="{{ name }}other-div">
        <div class="row align-items-center mb-3">
            <div class="col-auto">
                <label for="answer{{ name }}other" class="col-form-label" id="label-id-{{ name }}">{{ processString(othertext) }}</label>
            </div>
            <div class="col-auto">
                <input
                    class="form-control input-sm bootstrap-other-input"
                    type="text"
                    id="answer{{ name }}other"
                    name="{{ name }}_Cother"
                    aria-labelledby="label-id-{{ name }}"
                    {% if otherMandatoryTipId %} aria-describedby="{{ otherMandatoryTipId }}" {% endif %}
                    {% if otherInvalid %} aria-invalid="true" {% endif %}
                    data-name="{{ name }}other"
                    {% if otherInputSize %} size="{{ otherInputSize }}" {% endif %}
                    {% if otherMaxLength %} maxlength="{{ otherMaxLength }}" {% endif %}
                />
            </div>
            {% if otherTextRight is defined and otherTextRight|length > 0 %}
            <div class="othertext-suffix-label button-suffix col-auto">
                {{ processString(otherTextRight) }}
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>

<!-- end of answer -->
