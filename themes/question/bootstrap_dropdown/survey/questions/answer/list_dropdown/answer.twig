{#
/**
 * List DropDown select Html
 *
 * @var $sOptions         : the select options, generated with the view item_options.php
 * @var $sOther           : the other input field, generated with the view item_noanswer.php
 *
 * @var $name
 * @var $dropdownSize
 * @var $checkconditionFunction
 * @var $select_show_hide
 *
 */
#}


{% set data_live_search = (question_template_attribute.show_search == 'default' or question_template_attribute.show_search is empty or question_template_attribute.show_search == 'false') ? '' : "data-live-search='true'" %}
{% set show_tick = (question_template_attribute.show_tick == 'default' or question_template_attribute.show_tick is empty or question_template_attribute.show_tick == 'false') ? '' : "show-tick" %}
{% set width_entry = (question_template_attribute.width_entry == 'default' or question_template_attribute.width_entry is empty or question_template_attribute.width_entry == 'false') ? "data-width='auto'" : '' %}

<!-- List Dropdown -->

<!-- answer-->
<div class="mb-3 row align-items-center">
    <div class="{{ coreClass }} col-auto">
        <select
                class="form-control list-question-select {{ show_tick }}"
                {{ data_live_search }}
                {{ width_entry }}
                data-none-selected-text=''
                data-none-results-text="{{ sprintf(gT('No results matched %s'), '{0}')|escape }}"
                name="{{ name }}"
                id="answer{{ name }}"
                {% if dropdownSize %} data-size={{ dropdownSize }} {% endif %}
                aria-labelledby="ls-question-text-{{ basename }}"
        >
                {# rows/option.php #}
                {{ sOptions }}
        </select>

        {# Value for expression manager javascript (use id) ; no need to submit #}
        {{ C.Html.hiddenField("java"~name,value,({
            'id' : "java"~name,
            'disabled' : "disabled",
        }))
        }}
        {# Search result announcement for screen readers #}
        {% if data_live_search %}
            <output id="answer{{ name }}-search-status" class="visually-hidden" aria-live="polite" aria-atomic="true"></output>
        {% endif %}
    </div>
    {# rows/othertext.php #}
    {{ sOther }}
    <script type="text/javascript">
        $(function () {
            var selectPicker = $('#answer{{ name }}').selectpicker();

            {#
                Custom js to make width setting work with this beta version.
                The bootstrap-select's auto-width feature relies on a handler set for 'loaded.bs.select' by setWidth(),
                which is called after the event is triggered, so the auto-width's handler is never executed.
                This is a workaround to make the auto-width work.
            #}
            {% if width_entry != '' %}
            selectPicker.on('loaded.bs.select.firstload', function () {
                selectPicker.off('loaded.bs.select.firstload');
                // Trigger the event again with a slight delay to allow setWidth to run
                setTimeout(function () {
                    selectPicker.trigger('loaded.bs.select');
                }, 200);
            });
            {% endif %}

            {#
                Keyboard access for the answer options (WCAG 2.1 SC 2.1.1).

            #}
            var $bsWrapper = $('#answer{{ name }}').closest('.bootstrap-select');
            var $bsToggle  = $bsWrapper.find('.dropdown-toggle').first();

            $bsToggle.attr('data-toggle', 'dropdown');
            var handledKeys = ['ArrowUp', 'ArrowDown', 'Escape', 'Enter'];

            window.addEventListener('keydown', function (event) {
                if (handledKeys.indexOf(event.key) === -1) {
                    return;
                }
                // Ignore other widgets on the page; each one binds its own listener.
                if (!event.target || typeof event.target.closest !== 'function'
                    || event.target.closest('.bootstrap-select') !== $bsWrapper.get(0)) {
                    return;
                }
                var isOpen = $bsToggle.attr('aria-expanded') === 'true';

                if (event.key === 'Escape' && !isOpen) {
                    return;
                }

                event.stopPropagation();
                event.preventDefault();

                var $listbox = $bsWrapper.find('[role="listbox"]').first();
                var target = (isOpen && $listbox.length) ? $listbox.get(0) : $bsToggle.get(0);
                var keyCode = (event.key === 'Enter' && !isOpen) ? 40 : event.keyCode;

                $.fn.selectpicker.Constructor.prototype.keydown.call(
                    target,
                    $.Event('keydown', { which: keyCode, keyCode: keyCode })
                );

                if (event.key === 'Enter' && isOpen && $bsToggle.attr('aria-expanded') === 'true') {
                    $bsToggle.trigger('click.bs.dropdown.data-api').trigger('focus');
                }
            }, true);

            {% if data_live_search %}
            {# Announce the search result (number of results or no result) #}
            var $searchStatus = $('#answer{{ name }}-search-status');
            {# Unescaped : used with .text() #}
            {# Same strings and singular handling as the responses statistics in the editor #}
            var oneResultText = {{ json_encode(gT('1 result found', 'unescaped')) }};
            var resultsText = {{ json_encode(gT('%s results found', 'unescaped')) }};
            var noResultsText = {{ json_encode(gT('No results matched %s', 'unescaped')) }};
            var searchStatusTimer = null;
            {# No results message as a paragraph outside the listbox, replace the plugin <li class="no-results"> #}
            var $noResults = $('<p class="no-results mb-0" hidden></p>');
            $bsWrapper.find('[role="listbox"]').first().after($noResults);
            $bsWrapper.on('input', '.bs-searchbox input', function () {
                var search = this.value;
                var noResultsMessage = noResultsText.replace('%s', function () { return '"' + search + '"'; });
                {# Count from the filtered data, the DOM only has the visible part when virtual scroll is used #}
                var picker = selectPicker.data('selectpicker');
                var count = $.grep(picker.selectpicker.search.data, function (item) { return item.type === 'option'; }).length;
                $bsWrapper.find('[role="listbox"] li.no-results').remove();
                $noResults.text(noResultsMessage).prop('hidden', search === '' || count > 0);
                clearTimeout(searchStatusTimer);
                searchStatusTimer = setTimeout(function () {
                    var message = '';
                    if (search !== '') {
                        if (count === 0) {
                            message = noResultsMessage;
                        } else if (count === 1) {
                            message = oneResultText;
                        } else {
                            message = resultsText.replace('%s', count);
                        }
                    }
                    $searchStatus.text(message);
                }, 500);
            });
            selectPicker.on('hidden.bs.select', function () {
                clearTimeout(searchStatusTimer);
                $searchStatus.text('');
                $noResults.prop('hidden', true);
            });
            {% endif %}
        });

    </script>
</div>
<!-- end of answer  -->
