{# render the layout_global content block #}

{# Include the alert for no JavaScript #}
{{ include('./subviews/messages/no_js_alert.twig') }}

{% set hasImage = aSurveyInfo.welcomeimage['image_path'] is defined and aSurveyInfo.welcomeimage['image_path'] %}

{% if hasImage %}
    {# When a welcome image is set, it must also wrap the language changer and the main form (incl. privacy and navigator) #}
    {% embed './subviews/messages/welcome_subviews/welcome_image_container.twig' %}
        {% block welcome_wrapped_content %}
            {# Include the language changer selector #}
            {{ include('./subviews/navigation/language_changer_first_page.twig') }}

            {# Include the form opening tag #}
            {{ include('./subviews/header/start_form.twig') }} <!-- main form -->

                {# This will display the script and the hidden inputs needed for ExpressionScript Engine #}
                {{ aSurveyInfo.EM.ScriptsAndHiddenInputs }}

                {{ include('./subviews/messages/welcome_subviews/welcome_content.twig') }}

                {{ include('./subviews/privacy/privacy.twig') }}

                {{ include('./subviews/messages/welcome_subviews/welcome_questioncount.twig') }}

                {# Presents the navigator #}
                {{ include('./subviews/navigation/navigator.twig') }}
            </form> <!-- main form -->
        {% endblock %}
        {% block welcome_wrapped_footer %}
            {# The footer is rendered here (instead of layout_global.twig) so it is
               visually covered by the welcome image too #}
            {{ include('./subviews/footer/footer.twig') }}
        {% endblock %}
    {% endembed %}
{% else %}
    {# Include the language changer selector #}
    {{ include('./subviews/navigation/language_changer_first_page.twig') }}

    {# Include the form opening tag #}
    {{ include('./subviews/header/start_form.twig') }} <!-- main form -->

        {# This will display the script and the hidden inputs needed for ExpressionScript Engine #}
        {{ aSurveyInfo.EM.ScriptsAndHiddenInputs  }}

        {# If survey mode is "All in One", this will add the welcome/privacy messages (if activated) #}
        {{ include('./subviews/messages/welcome.twig') }}

        {# Presents the navigator #}
        {{ include('./subviews/navigation/navigator.twig') }}
    </form> <!-- main form -->
{% endif %}

{{ registerScript("BasicFirstPageThemeScripts", "
    if(window.basicThemeScripts === undefined){ 
        window.basicThemeScripts = new ThemeScripts(); 
    } 
", 'POS_POSTSCRIPT') }}
