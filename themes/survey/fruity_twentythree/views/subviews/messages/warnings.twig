    (¯`·._.·(¯`·._.· Warnings  ·._.·´¯)·._.·´¯)

    Show various warnings on top of the form

    Error Html warnings can be:
        - One or more mandatory questions have not been answered. You cannot proceed until these have been completed.
        - One or more questions have not been answered in a valid manner. You cannot proceed until these answers are valid.
        - One or more uploaded files are not in proper format/size. You cannot proceed until these files are valid.

    The easiest way to change the text in the warnings is to create a new translation.

    If questions with errors can be listed, the error summary is shown instead (also when popups are used), with a link to each question.

    These warnings are complementary to the popup ones. If you're using popups (set in config file), and then don't want to show these alerts, you can uncomment the hiddenClass checker
#}

{# Preview mode warning #}
{% if (aSurveyInfo.active != 'Y') and (not aSurveyInfo.popupPreview) %}
    <!-- Preview mode warning -->
    <div class="{{ aSurveyInfo.class.activealert }} alert alert-warning alert-dismissible fade in show alert-dismissible" {{ aSurveyInfo.attr.activealert }} >
        <button  {{ aSurveyInfo.attr.activealertbutton }} class="{{ aSurveyInfo.class.activealertbutton }} btn-close" ></button>
        {{ gT("This survey is currently not active. You will not be able to save your responses.") }}
    </div>
{% endif %}

{# Error summary: The questions with errors, each linked to its question, with the generic error messages above them #}
{% if aSurveyInfo.errorSummary.show|default(false) %}
    <div id="ls-error-summary" class="ls-error-summary alert alert-danger {{ aSurveyInfo.class.errorHtml }}" tabindex="-1" aria-labelledby="ls-error-summary-title">
        <div role="alert">
            <h2 id="ls-error-summary-title" class="ls-error-summary-title h5">{{ gT("Please check your answers") }}</h2>
            {% for aMessage in aSurveyInfo.errorHtml.messages %}
                <p>{{ aMessage }}</p>
            {% endfor %}
            <ul class="ls-error-summary-list mb-0">
                {% for aQuestionError in aSurveyInfo.errorSummary.questions %}
                    {% set sQuestionLink %}<a href="#question{{ aQuestionError.qid }}" class="ls-error-summary-link alert-link" data-qid="{{ aQuestionError.qid }}">{% if aQuestionError.number %}{{ aQuestionError.number }} {% endif %}{{ aQuestionError.text }}</a>{% endset %}
                    {% set sQuestionMessage %}<span id="ls-error-summary-message-{{ aQuestionError.qid }}" class="ls-error-summary-message">{% for sMessage in aQuestionError.messages %}{{ sMessage }}{% if not loop.last %} {% endif %}{% endfor %}</span>{% endset %}
                    {# Question and its error message: The translated pattern is escaped, link and message are already escaped HTML #}
                    <li>{{ gT("%s: %s")|escape|format(sQuestionLink, sQuestionMessage)|raw }}</li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {{ registerScript('activateErrorSummary', "activateErrorSummary();", "POS_END") }}
{# Error Html warnings, if no question can be listed #}
{% elseif aSurveyInfo.errorHtml.show %}
    <p class=' {# Uncomment to hide when popup is on { aSurveyInfo.errorHtml.hiddenClass } #} fade in show alert-dismissible alert alert-danger {{ aSurveyInfo.class.errorHtml }} ' role='alert'>
        <button  {{ aSurveyInfo.attr.errorHtmlbutton }} class="{{ aSurveyInfo.class.errorHtmlbutton }} btn-close" ></button>
    {% for aMessage in aSurveyInfo.errorHtml.messages  %}
        <!-- Error Html warnings -->
            {{ aMessage }}
            <br/>
    {% endfor %}
    </p>
{% endif %}

{{ makeFlashMessage() }}
