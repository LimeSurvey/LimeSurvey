<!-- Survey Name -->
<h1 class="{{ aSurveyInfo.class.surveyname }} large-heading mt-0" {{ aSurveyInfo.attr.surveyname }} >
    {{ processString(aSurveyInfo.name,1) }}
</h1>

<!-- Survey description -->
<div class="{{ aSurveyInfo.class.description }} reg-18" {{ aSurveyInfo.attr.description }}>
    {{ processString(aSurveyInfo.description,1) }}
</div>

<!-- Welcome text -->
<div class="{{ aSurveyInfo.class.welcome }} reg-18" {{ aSurveyInfo.attr.welcome }}>
    {{ processString(aSurveyInfo.welcome,1) }}
</div>
