<div class="position-relative overflow-hidden p-2">
    <img class="img-fluid w-100"
         src="{{ aSurveyInfo.welcomeimage.image_path }}"
         alt="{{ aSurveyInfo.welcomeimage.image_alt_text }}"
         style="{{ aSurveyInfo.welcomeimage.image_styles }}">
</div>
