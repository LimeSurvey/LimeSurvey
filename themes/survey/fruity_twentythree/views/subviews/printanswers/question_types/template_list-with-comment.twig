 {% extends "./subviews/printanswers/printanswers_question.twig" %}
 {% block question_answer %}
 <div class="{{ answerColumnClass|default('col-lg-8') }}">
    <div class="row">
        <div class="col-12">
            {{question.answervalue}} - {{question.answeroption.answer}}
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            {{question.comment.answervalue|escape}}
        </div>
    </div>
</div>
{% endblock %}
