 {% extends "./subviews/printanswers/printanswers_question.twig" %}
 {% block question_answer %}
 <div class="{{ answerColumnClass|default('col-lg-8') }}">
    {% for iterator, rankedvalue in question.answervalues %}
        <div class="row">
            <div class="col-lg-3">
                <b>{{gT('Rank')}} #{{(iterator+1)}}:</b>
            </div>
            <div class="col-lg-9">
                {{rankedvalue.value}}  - {{rankedvalue.answertext}}
            </div>
        </div>
    {% endfor %}

</div>
{% endblock %}
