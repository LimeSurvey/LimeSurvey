<div class="list-group index-button-full">
  <div class="list-group-item">
      <div id="index-button-heading" class="h4 list-group-item-heading">{{ gT("Question index") }}</div>
  </div>
  {% for step, indexItem in aSurveyInfo.aQuestionIndex.items %}
    {% set templateClass = '' %}
    {% if indexItem.stepStatus['index-item-unanswered'] is defined and indexItem.stepStatus['index-item-unanswered'] == true  %}
        {% set templateClass = templateClass ~ ' list-group-item-warning'  %}
    {% endif %}
    {% if indexItem.stepStatus['index-item-error'] is defined and indexItem.stepStatus['index-item-error'] == true   %}
        {% set templateClass = templateClass ~ ' list-group-item-danger'  %}
    {% endif %}
    {% if indexItem.stepStatus['index-item-current'] is defined and indexItem.stepStatus['index-item-current'] == true %}
        <button type="button" aria-disabled="true" aria-current="step"
            class="list-group-item {{ indexItem.coreClass }} {{ templateClass }} disabled">
            {{ indexItem.text }}
        </button>
    {% else %}
        <button type="submit" name="move" value="{{ indexItem.step }}"
            class="list-group-item {{ indexItem.coreClass }} {{ templateClass }}">
            {{ indexItem.text }}
        </button>
    {% endif %}
  {% endfor %}
</div>
