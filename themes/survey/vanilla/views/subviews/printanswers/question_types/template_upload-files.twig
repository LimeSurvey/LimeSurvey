 {% extends "./subviews/printanswers/printanswers_question.twig" %}
 {% block question_answer %}
<div class="{{ answerColumnClass|default('col-lg-8') }}">
    {% for file in question.fileinfo %}
        <div class="row">
                    <div class="col-lg-6">
                        <b>{{file.title}}</b></a>
                    </div>
                    <div class="col-lg-6">
                        {{file.comment == '' ? gT('No comment') : file.comment}}
                    </div>
                    <div class="col-lg-6">
                        {{ gT("File type") }} "{{file.ext}}"
                    </div>
                    <div class="col-lg-6">
                    </div>
                </div>
    {% endfor %}
</div>
{% endblock %}
