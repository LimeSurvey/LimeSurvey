{#
/**
 * This file render the asterisk for mandatory questions
 */
#}
<!-- The asterisk alone would convey "mandatory" by symbol only, so the word is shown too -->
<div class="asterisk">
  <sup class="text-danger fa fa-asterisk small" aria-hidden='true'></sup>
  <span class="text-danger small">{{ gT("Required") }}</span>
</div>
